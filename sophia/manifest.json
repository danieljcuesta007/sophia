{
  "manifest_version": 3,
  "name": "Sophia",
  "version": "0.2.0",
  "description": "A local writing companion. Select text in any editable field for corrections, word choices, and density analysis — free, offline, no API.",

  "background": { "service_worker": "service-worker.js" },

  "permissions": ["storage", "activeTab", "tabs"],

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/content.js"],
      "run_at": "document_idle"
    }
  ],

  "options_page": "options/options.html",

  "web_accessible_resources": [
    {
      "resources": ["data/quotes.json"],
      "matches": ["<all_urls>"]
    }
  ],

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "action": {
    "default_title": "Sophia",
    "default_popup": "popup/popup.html"
  }
}
